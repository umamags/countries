  "cultural_events": [
    {
      "name": "National Independence Day",
      "writeup": "",
      "wiki": {
        "extract": "The National Independence Day is a national day in Poland celebrated on 11 November to commemorate the anniversary of the restoration of Poland's sovereignty as the Second Polish Republic in 1918 from the German, Austro-Hungarian and Russian Empires. Following the partitions in the late 18th century, Poland ceased to exist as a sovereign and unified state for 123 years until the end of World War I, when the destruction of the neighbouring powers allowed the country to reemerge. It is a non-working day and a flag flying day in Poland.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/1/1f/Independence_Day_Warsaw_2013_MG_5572.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
        "url": "https://en.wikipedia.org/wiki/National_Independence_Day_(Poland)"
      }
    },
    {
      "name": "Traditional Music Festivals",
      "writeup": "",
      "wiki": {
        "extract": "Lisdoonvarna was a three-day Irish music festival held each year from 1978 to 1983. Conceived as an Irish folk and traditional music festival, it expanded to include other genres and international artists. The festival was compared to an Irish version of Woodstock or Glastonbury. Though successful, violence at the 1983 event and the unrelated drowning deaths of eight festival goers that year led to the event being cancelled after 1983. Attempts were made to revive the festival in 2003 and 2016.",
        "image": "https://upload.wikimedia.org/wikipedia/en/5/59/Lisdoonvarna_Music_Festival_1980_programme.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
        "url": "https://en.wikipedia.org/wiki/Lisdoonvarna_Music_Festival"
      }
    }
  ],
  "food_writeup": "Central African cuisine features staples like cassava, plantains, and rice, often accompanied by sauces made from peanuts, palm nuts, or vegetables. Fish and game meats are common protein sources.",
  "brief_history": "The Central African Republic gained independence from France in 1960. Since then, it has experienced political instability, coups, and conflicts involving various armed groups.",
