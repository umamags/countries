        "coordinates": null
      }
    },
    {
      "name": "Jesuit Missions of La Sant\u00edsima Trinidad de Paran\u00e1",
      "writeup": "A UNESCO World Heritage site featuring well-preserved ruins of a 17th-century Jesuit mission.",
      "wiki": {
        "extract": "The Jesuit Missions of La Sant\u00edsima Trinidad de Paran\u00e1 and Jes\u00fas de Tavarangue are located in the Itap\u00faa Department, Paraguay, and are religious missions that are still preserved and that were founded by the Jesuit missioners during the colonization of South America in the 17th century. These religious missions were created in 1609 and developed for 150 years. Both Jesuit missions were declared World Heritage Site by the UNESCO in 1993.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/6/61/Trinidad_%28Paraguay%29.JPG",
        "url": "https://en.wikipedia.org/wiki/Jesuit_Missions_of_La_Sant%C3%ADsima_Trinidad_de_Paran%C3%A1_and_Jes%C3%BAs_de_Tavarangue",
        "coordinates": {
          "lat": -27.13333333,
          "lon": -55.7
        }
      }
    },
    {
      "name": "Palacio de los L\u00f3pez",
      "writeup": "The presidential palace in Asunci\u00f3n, known for its neoclassical architecture and historical significance.",
      "wiki": {
        "extract": "Palacio de los L\u00f3pez, officially titled Palacio de Gobierno is a neoclassical manor in Asunci\u00f3n, Paraguay, that serves as a workplace for the President of Paraguay, and as the seat of the government of Paraguay. The president does not reside in the palace, and is instead housed at Mburuvicha R\u00f3ga, some 2.5 km to the southeast.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/3/35/Palacio_de_los_L%C3%B3pez.jpg",
        "url": "https://en.wikipedia.org/wiki/Palacio_de_los_L%C3%B3pez",
        "coordinates": {
          "lat": -25.27763611,
          "lon": -57.63756944
        }
      }
    }
